{
  "name": "agrivault-backend",
  "version": "1.0.0",
  "description": "Production-ready backend for AgriVault Cold Storage & Warehouse Environmental Monitoring",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --minify --outfile=index.js --external:node:sqlite && node -e \"require('fs').copyFileSync('index.js', 'dist/index.js')\"",
    "start": "node index.js",
    "seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.2",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "aedes": "^0.51.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.10.4",
    "sql.js": "^1.14.2",
    "typescript": "^5.7.2",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
